<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>

<!--
  =====================================================
  TEMPLATE BLOGGER RESPONSIF & SEO-FRIENDLY
  Framework  : Tailwind CSS (CDN)
  Iklan      : Slot Google AdSense di bawah judul artikel
  Versi      : 1.0
  =====================================================
-->

<b:skin><![CDATA[ /* kosong – styling via Tailwind */ ]]></b:skin>

<html b:css='false' b:defaultwidgetversion='2' b:layoutsVersion='3'
      b:responsive='true' b:templateUrl='custom' b:templateVersion='1.0.0'
      expr:dir='data:blog.languageDirection'
      expr:lang='data:blog.locale'
      xmlns='http://www.w3.org/1999/xhtml'
      xmlns:b='http://www.google.com/2005/gbl'
      xmlns:data='http://www.google.com/2005/gbl'
      xmlns:expr='http://www.google.com/2005/gbl'>

<!-- ================================================
     HEAD
     ================================================ -->
<head>
  <b:include data='blog' name='all-head-content'/>

  <!-- Charset & Viewport -->
  <meta charset='utf-8'/>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <meta content='IE=edge' http-equiv='X-UA-Compatible'/>

  <!-- ── SEO Meta Tags ── -->
  <b:if cond='data:blog.pageType == &quot;item&quot;'>
    <!-- Halaman Artikel -->
    <title><data:blog.pageName/> | <data:blog.title/></title>
    <meta expr:content='data:blog.metaDescription' name='description'/>
    <meta expr:content='data:blog.pageName' name='keywords'/>

    <!-- Open Graph -->
    <meta content='article' property='og:type'/>
    <meta expr:content='data:blog.pageName + &quot; | &quot; + data:blog.title' property='og:title'/>
    <meta expr:content='data:blog.metaDescription' property='og:description'/>
    <meta expr:content='data:blog.canonicalUrl' property='og:url'/>
    <b:if cond='data:blog.postImageThumbnailUrl'>
      <meta expr:content='data:blog.postImageThumbnailUrl' property='og:image'/>
    </b:if>

    <!-- Twitter Card -->
    <meta content='summary_large_image' name='twitter:card'/>
    <meta expr:content='data:blog.pageName + &quot; | &quot; + data:blog.title' name='twitter:title'/>
    <meta expr:content='data:blog.metaDescription' name='twitter:description'/>

    <!-- Canonical -->
    <link expr:href='data:blog.canonicalUrl' rel='canonical'/>

    <!-- JSON-LD Article Schema -->
    <script type='application/ld+json'>
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "<data:blog.pageName/>",
      "description": "<data:blog.metaDescription/>",
      "url": "<data:blog.canonicalUrl/>",
      "publisher": {
        "@type": "Organization",
        "name": "<data:blog.title/>"
      }
    }
    </script>

  <b:else/>
    <!-- Halaman Utama / Kategori -->
    <title><data:blog.pageTitle/></title>
    <meta expr:content='data:blog.metaDescription' name='description'/>
    <meta content='index, follow' name='robots'/>
    <link expr:href='data:blog.homepageUrl' rel='canonical'/>

    <!-- Open Graph Homepage -->
    <meta content='website' property='og:type'/>
    <meta expr:content='data:blog.pageTitle' property='og:title'/>
    <meta expr:content='data:blog.metaDescription' property='og:description'/>
    <meta expr:content='data:blog.homepageUrl' property='og:url'/>
  </b:if>

  <!-- Breadcrumb Schema -->
  <script type='application/ld+json'>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "<data:blog.homepageUrl/>" }
    ]
  }
  </script>

  <!-- ── Tailwind CSS (CDN) ── -->
  <script src='https://cdn.tailwindcss.com'></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50:  '#f0fdf4',
              100: '#dcfce7',
              500: '#22c55e',
              600: '#16a34a',
              700: '#15803d',
              900: '#14532d',
            }
          },
          fontFamily: {
            sans: ['Lato', 'sans-serif'],
            heading: ['Merriweather', 'serif'],
          }
        }
      }
    }
  </script>

  <!-- Google Fonts -->
  <link href='https://fonts.googleapis.com/css2?family=Merriweather:wght@700;900&amp;family=Lato:wght@400;600&amp;display=swap' rel='stylesheet'/>

  <!-- Global Styles (non-Tailwind utilities) -->
  <style>
    /* Prose: konten artikel */
    .post-body h2 { @apply text-2xl font-heading font-bold mt-8 mb-3 text-gray-800; }
    .post-body h3 { @apply text-xl font-heading font-bold mt-6 mb-2 text-gray-800; }
    .post-body p  { @apply mb-4 leading-relaxed text-gray-700; }
    .post-body a  { @apply text-brand-600 underline hover:text-brand-700; }
    .post-body ul { @apply list-disc pl-6 mb-4 text-gray-700; }
    .post-body ol { @apply list-decimal pl-6 mb-4 text-gray-700; }
    .post-body img{ @apply rounded-lg my-4 max-w-full h-auto; }
    .post-body blockquote {
      @apply border-l-4 border-brand-500 pl-4 italic text-gray-500 my-4;
    }

    /* Scrollbar tipis */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-thumb { background: #22c55e; border-radius: 3px; }

    /* Animasi fade-in sederhana */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .fade-up { animation: fadeUp .5s ease both; }
  </style>

  <!-- AdSense Script (ganti ca-pub-XXXXXXXXXXXXXXXX dengan ID Anda) -->
  <script async='async' crossorigin='anonymous'
    src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX'>
  </script>
</head>

<!-- ================================================
     BODY
     ================================================ -->
<body class='bg-gray-50 text-gray-900 font-sans antialiased'>

  <!-- ── HEADER / NAVBAR ── -->
  <header class='bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm'>
    <div class='max-w-6xl mx-auto px-4 py-3 flex items-center justify-between'>

      <!-- Logo / Nama Blog -->
      <a class='font-heading text-2xl font-black text-brand-700 hover:text-brand-600 transition-colors'
         expr:href='data:blog.homepageUrl'>
        <data:blog.title/>
      </a>

      <!-- Navigasi Desktop -->
      <nav class='hidden md:flex items-center gap-6 text-sm font-semibold text-gray-600'>
        <a class='hover:text-brand-600 transition-colors' expr:href='data:blog.homepageUrl'>Beranda</a>
        <!-- Tambahkan menu kustom sesuai kebutuhan -->
        <a class='hover:text-brand-600 transition-colors' href='/p/tentang-kami.html'>Tentang</a>
        <a class='hover:text-brand-600 transition-colors' href='/p/kontak.html'>Kontak</a>
      </nav>

      <!-- Search Icon Mobile -->
      <button aria-label='Cari' class='md:hidden text-gray-500 hover:text-brand-600'>
        <svg class='w-5 h-5' fill='none' stroke='currentColor' stroke-width='2'
             viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'>
          <path d='M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z'
                stroke-linecap='round' stroke-linejoin='round'/>
        </svg>
      </button>
    </div>
  </header>

  <!-- ── KONTEN UTAMA ── -->
  <main class='max-w-6xl mx-auto px-4 py-8 fade-up'>
    <div class='flex flex-col lg:flex-row gap-8'>

      <!-- ━━━━━━━━━━━━━━━━━━━━━━━
           KOLOM ARTIKEL (2/3)
           ━━━━━━━━━━━━━━━━━━━━━━━ -->
      <section class='w-full lg:w-2/3'>

        <!-- Widget: Halaman Artikel (item) -->
        <b:if cond='data:blog.pageType == &quot;item&quot;'>
          <b:loop values='data:posts' var='post'>

            <article class='bg-white rounded-2xl shadow-sm overflow-hidden mb-8'
                     expr:id='data:post.id'
                     itemscope='' itemtype='https://schema.org/BlogPosting'>

              <!-- Gambar Thumbnail -->
              <b:if cond='data:post.firstImageUrl'>
                <div class='relative h-64 md:h-80 overflow-hidden'>
                  <img alt='' class='w-full h-full object-cover'
                       expr:src='data:post.firstImageUrl' itemprop='image'/>
                </div>
              </b:if>

              <div class='p-6 md:p-8'>

                <!-- Kategori / Label -->
                <b:if cond='data:post.labels'>
                  <div class='flex flex-wrap gap-2 mb-3'>
                    <b:loop values='data:post.labels' var='label'>
                      <a class='inline-block bg-brand-50 text-brand-700 text-xs font-semibold
                                 px-3 py-1 rounded-full hover:bg-brand-100 transition-colors'
                         expr:href='data:label.url' itemprop='articleSection'>
                        <data:label.name/>
                      </a>
                    </b:loop>
                  </div>
                </b:if>

                <!-- Judul Artikel (H1) -->
                <h1 class='font-heading text-3xl md:text-4xl font-black text-gray-900
                           leading-tight mb-3' itemprop='headline'>
                  <data:post.title/>
                </h1>

                <!-- Meta: Author & Tanggal -->
                <div class='flex flex-wrap items-center gap-4 text-sm text-gray-500 mb-6
                            pb-6 border-b border-gray-100'>
                  <span class='flex items-center gap-1'>
                    <svg class='w-4 h-4' fill='none' stroke='currentColor' stroke-width='2'
                         viewBox='0 0 24 24'>
                      <path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'
                            stroke-linecap='round' stroke-linejoin='round'/>
                      <circle cx='12' cy='7' r='4' stroke-linecap='round' stroke-linejoin='round'/>
                    </svg>
                    <span itemprop='author'><data:post.author/></span>
                  </span>
                  <span class='flex items-center gap-1'>
                    <svg class='w-4 h-4' fill='none' stroke='currentColor' stroke-width='2'
                         viewBox='0 0 24 24'>
                      <rect height='18' rx='2' ry='2' stroke-linecap='round'
                            stroke-linejoin='round' width='18' x='3' y='4'/>
                      <line stroke-linecap='round' stroke-linejoin='round'
                            x1='16' x2='16' y1='2' y2='6'/>
                      <line stroke-linecap='round' stroke-linejoin='round'
                            x1='8' x2='8' y1='2' y2='6'/>
                      <line stroke-linecap='round' stroke-linejoin='round'
                            x1='3' x2='21' y1='10' y2='10'/>
                    </svg>
                    <time expr:datetime='data:post.date.iso8601' itemprop='datePublished'>
                      <data:post.date/>
                    </time>
                  </span>
                </div>

                <!-- ╔══════════════════════════════════════╗
                     ║  SLOT IKLAN — DI BAWAH JUDUL         ║
                     ║  Ganti data-ad-slot dengan ID slot   ║
                     ║  AdSense Anda                        ║
                     ╚══════════════════════════════════════╝ -->
                <div class='my-6 flex justify-center'>
                  <ins class='adsbygoogle'
                       data-ad-client='ca-pub-XXXXXXXXXXXXXXXX'
                       data-ad-format='auto'
                       data-ad-slot='XXXXXXXXXX'
                       data-full-width-responsive='true'
                       style='display:block'/>
                  <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
                </div>
                <!-- ═══════════════ END IKLAN ════════════ -->

                <!-- Isi Konten Artikel -->
                <div class='post-body text-base leading-7' itemprop='articleBody'>
                  <data:post.body/>
                </div>

                <!-- Share Buttons -->
                <div class='mt-8 pt-6 border-t border-gray-100'>
                  <p class='text-sm font-semibold text-gray-500 mb-3'>Bagikan artikel:</p>
                  <div class='flex flex-wrap gap-3'>
                    <!-- WhatsApp -->
                    <a class='flex items-center gap-2 bg-green-500 hover:bg-green-600
                               text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors'
                       expr:href='&quot;https://wa.me/?text=&quot; + data:post.url'
                       rel='noopener' target='_blank'>
                      <svg class='w-4 h-4' fill='currentColor' viewBox='0 0 24 24'>
                        <path d='M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15
                          -.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39
                          -1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298
                          -.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149
                          -.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01
                          -.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875
                          1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227
                          1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173
                          -1.413-.074-.124-.272-.198-.57-.347z'/>
                        <path d='M11.997 2C6.477 2 2 6.477 2 12.001a9.953 9.953 0 0 0 1.358 5.003L2
                          22l5.119-1.342A9.955 9.955 0 0 0 11.997 22C17.521 22 22 17.523 22 12.001
                          22 6.477 17.521 2 11.997 2zm0 18.198a8.196 8.196 0 0 1-4.181-1.145l-.3-.179
                          -3.038.797.813-2.969-.196-.307A8.197 8.197 0 1 1 11.997 20.198z'/>
                      </svg>
                      WhatsApp
                    </a>
                    <!-- Facebook -->
                    <a class='flex items-center gap-2 bg-blue-600 hover:bg-blue-700
                               text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors'
                       expr:href='&quot;https://www.facebook.com/sharer/sharer.php?u=&quot; + data:post.url'
                       rel='noopener' target='_blank'>
                      <svg class='w-4 h-4' fill='currentColor' viewBox='0 0 24 24'>
                        <path d='M24 12.073C24 5.406 18.627 0 12 0S0 5.406 0 12.073C0 18.1
                          4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025
                          1.791-4.697 4.533-4.697 1.313 0 2.686.235 2.686.235v2.97h-1.513
                          c-1.491 0-1.956.93-1.956 1.886v2.268h3.328l-.532 3.49h-2.796V24
                          C19.612 23.094 24 18.1 24 12.073z'/>
                      </svg>
                      Facebook
                    </a>
                    <!-- Twitter / X -->
                    <a class='flex items-center gap-2 bg-black hover:bg-gray-800
                               text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors'
                       expr:href='&quot;https://twitter.com/intent/tweet?url=&quot; + data:post.url + &quot;&amp;text=&quot; + data:post.title'
                       rel='noopener' target='_blank'>
                      <svg class='w-4 h-4' fill='currentColor' viewBox='0 0 24 24'>
                        <path d='M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714
                          -6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.259
                          5.629 5.905-5.629zm-1.161 17.52h1.833L7.084 4.126H5.117z'/>
                      </svg>
                      X / Twitter
                    </a>
                  </div>
                </div>
              </div><!-- /p-6 -->
            </article><!-- /article -->

            <!-- Komentar Blogger -->
            <div class='bg-white rounded-2xl shadow-sm p-6 md:p-8 mb-8'>
              <b:include data='post' name='comments'/>
            </div>

          </b:loop>

        <!-- Widget: Halaman Utama (daftar artikel) -->
        <b:else/>
          <b:loop values='data:posts' var='post'>
            <article class='bg-white rounded-2xl shadow-sm overflow-hidden mb-6 flex
                           flex-col md:flex-row hover:shadow-md transition-shadow'>

              <!-- Thumbnail List -->
              <b:if cond='data:post.firstImageUrl'>
                <a class='block md:w-56 flex-shrink-0' expr:href='data:post.url'>
                  <img alt='' class='w-full h-48 md:h-full object-cover'
                       expr:src='data:post.firstImageUrl'/>
                </a>
              </b:if>

              <div class='p-5 flex flex-col justify-between'>
                <!-- Label -->
                <b:if cond='data:post.labels'>
                  <div class='flex flex-wrap gap-2 mb-2'>
                    <b:loop values='data:post.labels' var='label'>
                      <a class='text-xs font-semibold text-brand-700 bg-brand-50
                                 px-2 py-0.5 rounded-full hover:bg-brand-100 transition-colors'
                         expr:href='data:label.url'>
                        <data:label.name/>
                      </a>
                    </b:loop>
                  </div>
                </b:if>

                <!-- Judul -->
                <h2 class='font-heading text-xl font-bold text-gray-900 hover:text-brand-700
                           leading-snug mb-2 transition-colors'>
                  <a expr:href='data:post.url'><data:post.title/></a>
                </h2>

                <!-- Snippet -->
                <p class='text-sm text-gray-600 line-clamp-2 mb-4'>
                  <data:post.snippet/>
                </p>

                <!-- Meta & CTA -->
                <div class='flex items-center justify-between'>
                  <time class='text-xs text-gray-400' expr:datetime='data:post.date.iso8601'>
                    <data:post.date/>
                  </time>
                  <a class='text-sm font-semibold text-brand-700 hover:text-brand-600 transition-colors'
                     expr:href='data:post.url'>
                    Baca selengkapnya →
                  </a>
                </div>
              </div>

            </article>
          </b:loop>

          <!-- Pagination -->
          <div class='flex justify-center gap-4 mt-6'>
            <b:include name='nextprev'/>
          </div>
        </b:if>
        <!-- /b:if pageType -->

      </section>
      <!-- /KOLOM ARTIKEL -->

      <!-- ━━━━━━━━━━━━━━━━━━━━━━━
           SIDEBAR (1/3)
           ━━━━━━━━━━━━━━━━━━━━━━━ -->
      <aside class='w-full lg:w-1/3 space-y-6'>

        <!-- Search Widget -->
        <div class='bg-white rounded-2xl shadow-sm p-5'>
          <h3 class='font-heading text-lg font-bold text-gray-800 mb-3'>Cari Artikel</h3>
          <b:widget id='Search1' type='SearchForm' version='2'>
            <b:widget-settings/>
          </b:widget>
        </div>

        <!-- Iklan Sidebar -->
        <div class='bg-white rounded-2xl shadow-sm p-5 flex justify-center'>
          <ins class='adsbygoogle'
               data-ad-client='ca-pub-XXXXXXXXXXXXXXXX'
               data-ad-format='auto'
               data-ad-slot='YYYYYYYYYY'
               data-full-width-responsive='true'
               style='display:block; min-width:250px'/>
          <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
        </div>

        <!-- Artikel Populer / Label -->
        <div class='bg-white rounded-2xl shadow-sm p-5'>
          <h3 class='font-heading text-lg font-bold text-gray-800 mb-3'>Kategori</h3>
          <b:widget id='Label1' type='Label' version='2'>
            <b:widget-settings>
              <b:with value='list' var='selectedLabelType'/>
            </b:widget-settings>
          </b:widget>
        </div>

        <!-- Artikel Terbaru -->
        <div class='bg-white rounded-2xl shadow-sm p-5'>
          <h3 class='font-heading text-lg font-bold text-gray-800 mb-3'>Artikel Terbaru</h3>
          <b:widget id='BlogArchive1' type='BlogArchive' version='2'>
            <b:widget-settings/>
          </b:widget>
        </div>

      </aside>
      <!-- /SIDEBAR -->

    </div><!-- /flex -->
  </main>

  <!-- ── FOOTER ── -->
  <footer class='bg-gray-900 text-gray-300 mt-12'>
    <div class='max-w-6xl mx-auto px-4 py-10'>
      <div class='flex flex-col md:flex-row items-center justify-between gap-4'>

        <!-- Blog Name -->
        <a class='font-heading text-xl font-black text-white hover:text-brand-400 transition-colors'
           expr:href='data:blog.homepageUrl'>
          <data:blog.title/>
        </a>

        <!-- Footer Nav -->
        <nav class='flex flex-wrap justify-center gap-5 text-sm text-gray-400'>
          <a class='hover:text-white transition-colors' href='/p/kebijakan-privasi.html'>Kebijakan Privasi</a>
          <a class='hover:text-white transition-colors' href='/p/disclaimer.html'>Disclaimer</a>
          <a class='hover:text-white transition-colors' href='/p/tentang-kami.html'>Tentang Kami</a>
          <a class='hover:text-white transition-colors' href='/p/kontak.html'>Kontak</a>
        </nav>

      </div>
      <div class='mt-6 pt-6 border-t border-gray-700 text-center text-xs text-gray-500'>
        &copy; <script>document.write(new Date().getFullYear())</script>
        <a class='hover:text-white' expr:href='data:blog.homepageUrl'>
          <data:blog.title/>
        </a>. Hak cipta dilindungi undang-undang.
      </div>
    </div>
  </footer>

  <!-- ── Back to Top Button ── -->
  <button aria-label='Kembali ke atas'
          class='fixed bottom-6 right-6 bg-brand-600 hover:bg-brand-700 text-white
                 w-10 h-10 rounded-full shadow-lg flex items-center justify-center
                 transition-all opacity-0' id='backToTop'>
    <svg class='w-5 h-5' fill='none' stroke='currentColor' stroke-width='2.5'
         viewBox='0 0 24 24'>
      <path d='M18 15l-6-6-6 6' stroke-linecap='round' stroke-linejoin='round'/>
    </svg>
  </button>

  <script>
    // Back to top
    const btn = document.getElementById('backToTop');
    window.addEventListener('scroll', () => {
      btn.style.opacity = window.scrollY > 300 ? '1' : '0';
    });
    btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  </script>

</body>
</html>
